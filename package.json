{
  "name": "grano",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:jasmine && npm run test:rutas",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:logica": "npm test",
    "test:componentes": "npm run test:jasmine",
    "test:jasmine": "vite build --config vite.pruebas.config.js && karma start karma.conf.cjs --single-run",
    "test:rutas": "node --test tests/integracion/*.test.js",
    "test:cobertura": "vite build --config vite.pruebas.config.js --mode cobertura && karma start karma.cobertura.conf.cjs --single-run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "istanbul-lib-instrument": "6.0.3",
    "jasmine-core": "7.0.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
